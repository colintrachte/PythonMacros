[
    {
        "pluginKey": "endmill_utils.remove_before_first_M03",
        "description": "Keep content after the configured spindle-on marker",
        "isChecked": true,
        "args": {
            "start_command": "M03",
            "keep_start_command": false,
            "require_start_command": true
        }
    },
    {
        "pluginKey": "endmill_utils.normalize_gcode_format",
        "description": "Normalize formatting while preserving rapid and linear moves",
        "isChecked": true,
        "args": {
            "decimal_places": 2,
            "normalize_leading_zeros": true
        }
    },
    {
        "pluginKey": "endmill_utils.insert_endmill_power_before_first_z_move",
        "description": "Activate the configured endmill output before the first Z move",
        "isChecked": true,
        "args": {
            "pin_name": "end_mill",
            "power": 250,
            "power_command": "",
            "motion_codes": "G0|G1",
            "require_z_move": true
        }
    },
    {
        "pluginKey": "endmill_utils.remove_after_M107",
        "description": "Stop at the configured spindle-off marker",
        "isChecked": true,
        "args": {
            "end_command": "M107",
            "keep_end_command": false,
            "require_end_command": true
        }
    },
    {
        "pluginKey": "endmill_utils.add_printer_header",
        "description": "Add configured homing and tool-selection commands",
        "isChecked": true,
        "args": {
            "home_command": "HOME_PRINTER ; Home all axes",
            "tool_command": "GRAB_ENDMILL"
        }
    },
    {
        "pluginKey": "endmill_utils.add_footer",
        "description": "Add configured shutdown and tool-release commands",
        "isChecked": true,
        "args": {
            "shutdown_command": "SET_PIN PIN=end_mill VALUE=0",
            "home_command": "HOME_XY",
            "tool_command": "TOOL_DROPOFF"
        }
    }
]
